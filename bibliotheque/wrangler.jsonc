// Cloudflare Workers : le nom doit être le même que le « Project name » choisi dans Cloudflare.
{
  "name": "bibliotheque",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "COFFRE", "class_name": "Coffre" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Coffre"] }],
  "observability": { "enabled": true },
  // garde les variables réglées dans le tableau de bord Cloudflare (MOT_DE_PASSE) à chaque déploiement
  "keep_vars": true
}
