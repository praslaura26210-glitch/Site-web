{
  "name": "bibliotheque",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"vite\"",
    "dev:api": "tsx scripts/serveur-local.ts",
    "build": "tsc --noEmit && vite build",
    "local": "vite build && tsx scripts/serveur-local.ts --dist",
    "typecheck": "tsc --noEmit",
    "apercu": "node scripts/apercu.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@netlify/blobs": "^11.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "wrangler": "^4.148.0"
  }
}
